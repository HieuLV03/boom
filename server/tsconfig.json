
{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "strict": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,

        "experimentalDecorators": true,
        "useDefineForClassFields": false,

        "sourceMap": true,

        "rootDir": "..",
        "outDir": "./dist"
    },

    "include": [
        "src/**/*.ts",
        "../shared/maps/grid-map.ts"
    ]
}
