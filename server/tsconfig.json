{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",

        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,

        "experimentalDecorators": true,
        "useDefineForClassFields": false,

        "sourceMap": true,

        "rootDir": "./src",
        "outDir": "./dist"
    },

    "include": [
        "src/**/*.ts"
    ]
}